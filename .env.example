# ============================================================================
# Frog Focus TTS backend — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` (in this same folder) and fill in your real values.
# `.env` is git-ignored and is NOT served to the browser — this is what keeps
# your key out of client-side code / page source.
#
#     cp .env.example .env
#
# Then edit `.env` and set ELEVENLABS_API_KEY. Also remember to ROTATE the key
# that was pasted in chat once this is live.
# ============================================================================

# REQUIRED — your ElevenLabs API key.
# Find/create one at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# OPTIONAL — the voice the frog speaks with. Default: Antoni, a warm and
# friendly male voice. Any ElevenLabs voice id works here.
#
#   Antoni  ErXwobaYiN019PkySvjV   (default — warm, reassuring, friend-like)
#   Adam    pNInz6obpgDQGcFmaJgB   (deeper, calm American male)
#   Rachel  21m00Tcm4TlvDq8ikWAM   (warm, gentle American female)
#   Charlie IKne3meq5aSn9XLyUdCD   (natural, easygoing male)
ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV

# OPTIONAL — synthesis model.
#   eleven_turbo_v2_5         (default — fast, low-latency, low cost)
#   eleven_multilingual_v2    (highest quality, a bit slower)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# OPTIONAL — port the backend listens on. Default: 8787.
PORT=8787
